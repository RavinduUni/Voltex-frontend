# Where the Spring Boot backend runs (used by the Vite dev proxy).
VITE_BACKEND_URL=http://voltex-backend-env.eba-iyuzr5pv.ap-south-1.elasticbeanstalk.com

# Base path axios uses for API calls. Keep "/api" when using the proxy or a rewrite.
# Only set a full URL (e.g. https://api.example.com/api) if you add CORS to the backend.
VITE_API_BASE_URL=/api

# Display currency (ISO code) and locale for prices.
VITE_CURRENCY=LKR
VITE_LOCALE=en-LK

# Optional: your ImageKit URL endpoint if you use a custom domain, so product images
# are requested at display size. ik.imagekit.io URLs are detected automatically.
VITE_IMAGEKIT_ENDPOINT=
